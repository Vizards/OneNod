{
  "manifest_version": 3,
  "name": "OneNod Form Fill",
  "version": "0.1.0",
  "description": "Fill agent-selected web fields from approved OneNod references.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Reconnect OneNod Form Fill"
  }
}
