{
  "name": "@onenod/executor",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "audit:artifact": "node scripts/audit-artifact.mjs",
    "build": "pnpm build:worker && pnpm audit:artifact",
    "build:core": "node scripts/build-core.mjs",
    "build:worker": "pnpm build:core && node scripts/build-worker.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "oxlint src test scripts --deny-warnings",
    "test": "node --import tsx --test test/*.test.*",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@extism/extism": "2.0.0-rc13",
    "@onenod/protocol": "workspace:*",
    "@scure/base": "2.2.0",
    "canonicalize": "3.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/ssh2": "1.15.5",
    "binaryen": "131.0.0",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
