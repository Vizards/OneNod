      "architectures": [
        "arm64",
        "amd64"
      ]
    },
    "node": {
      "minimum": "22.12.0",
      "maximum_exclusive": "23.0.0"
    },
    "wrangler": {
      "minimum": "4.116.0",
      "maximum_exclusive": "5.0.0"
    },
    "onepassword_cli": {
      "minimum": "2.34.0",
      "maximum_exclusive": "3.0.0"
