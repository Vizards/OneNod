{
  "schema_version": 1,
  "repository": "Vizards/OneNod",
  "workflow": ".github/workflows/release.yml",
  "release_train": {
    "target_version": "0.0.2"
  },
  "release_channels": {
    "alpha": {
      "github_prerelease": true,
      "github_latest": false,
      "product_label": "Alpha"
    },
    "beta": {
      "github_prerelease": true,
      "github_latest": false,
      "product_label": "Beta"
    },
    "stable": {
      "github_prerelease": false,
      "github_latest": true,
      "product_label": "Public Preview"
    }
  },
  "components": {
    "may": {
      "client_protocol": 2,
      "code_identity": {
        "scheme": "apple-cdhash",
        "signing": "adhoc",
        "identifier": "com.github.vizards.onenod.may",
        "hardened_runtime": true
      },
      "adapter_code_identity": {
        "scheme": "apple-cdhash",
        "signing": "adhoc",
        "identifier": "com.github.vizards.onenod.may-ssh-sign",
        "hardened_runtime": true
      }
    },
    "keychain_helper": {
      "version": "3.0.0",
      "source_digest": "sha256:2a08eee1071d1b0ce4f40964e3e0de198cfdb25a173c1a3ea8860c27a29f069e",
      "code_identity": {
        "scheme": "apple-cdhash",
        "signing": "adhoc",
        "identifier": "com.github.vizards.onenod.keychain-helper",
        "hardened_runtime": true
      },
      "helper_protocol": {
        "min": 3,
        "max": 3
      }
    },
    "gateway": {
      "accepted_client_protocol": {
        "min": 1,
        "max": 2
      },
      "state_schema": 2
