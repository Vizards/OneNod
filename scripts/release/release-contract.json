    "executor": {
      "accepted_gateway_protocol": {
        "min": 1,
        "max": 1
      },
      "state_schema": 1
    }
  },
  "upgrade": {
    "minimum_updater_version": "0.0.1",
    "minimum_safe_version": "0.0.1",
    "revoked_artifact_digests": [],
    "order": [
      "executor",
      "gateway",
      "local",
      "skill"
